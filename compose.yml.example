services:
  # ----------------------------------------------------------------------------
  # Gateway / Reverse Proxy Nginx
  # Único serviço com portas expostas no host para as aplicações web e serviços
  # ----------------------------------------------------------------------------
  nginx:
    image: nginx:alpine
    container_name: global-tools-nginx
    restart: unless-stopped
    ports:
      - "${PORT_MINIO_API:-7104}:9000"
      - "${PORT_MINIO_CONSOLE:-7105}:9001"
    volumes:
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
    depends_on:
      - minio
    networks:
      - global-minio-network

  # ----------------------------------------------------------------------------
  # Object Storage S3 Compatível (MinIO)
  # Portas expostas no host exclusivamente via Gateway Nginx (9000 e 9001)
  # ----------------------------------------------------------------------------
  minio:
    image: ${MINIO_IMAGE:-chainguard/minio:latest}
    container_name: global-tools-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-admin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-password}
      MINIO_SERVER_URL: ${MINIO_SERVER_URL:-https://s3.storage.tiagofranca.com}
      MINIO_BROWSER_REDIRECT_URL: ${MINIO_BROWSER_REDIRECT_URL:-https://cdn.storage.tiagofranca.com}
    expose:
      - "9000"
      - "9001"
    volumes:
      - ./data/minio:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - global-minio-network

  # ----------------------------------------------------------------------------
  # Provisionamento Automático de Buckets, Políticas e Chaves S3
  # ----------------------------------------------------------------------------
  minio-init:
    image: ${MINIO_IMAGE:-chainguard/minio:latest}
    container_name: global-tools-minio-init
    depends_on:
      minio:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
      /usr/bin/mc alias set local http://minio:9000 $${MINIO_ROOT_USER} $${MINIO_ROOT_PASSWORD};
      if [ -n \"$${MINIO_DEFAULT_BUCKET}\" ]; then
        /usr/bin/mc mb --ignore-existing local/$${MINIO_DEFAULT_BUCKET};
        /usr/bin/mc anonymous set download local/$${MINIO_DEFAULT_BUCKET};
      fi;
      if [ -n \"$${MINIO_DEFAULT_ACCESS_KEY}\" ] && [ -n \"$${MINIO_DEFAULT_SECRET_KEY}\" ]; then
        /usr/bin/mc admin accesskey create local --access-key $${MINIO_DEFAULT_ACCESS_KEY} --secret-key $${MINIO_DEFAULT_SECRET_KEY} || true;
      fi;
      exit 0;
      "
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-admin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-password}
      MINIO_DEFAULT_BUCKET: ${MINIO_DEFAULT_BUCKET:-my-first-bucket}
      MINIO_DEFAULT_ACCESS_KEY: ${MINIO_DEFAULT_ACCESS_KEY}
      MINIO_DEFAULT_SECRET_KEY: ${MINIO_DEFAULT_SECRET_KEY}
    networks:
      - global-minio-network
    restart: "no"

networks:
  global-minio-network:
    driver: bridge
