## Portas de Object Storage (MinIO) através do Nginx
PORT_MINIO_API=7104 ## API S3 s3.storage.tiagofranca.com 9000
PORT_MINIO_CONSOLE=7105 ## Console web cdn.storage.tiagofranca.com 9001

MINIO_SERVER_URL="https://s3.storage.tiagofranca.com"
MINIO_BROWSER_REDIRECT_URL="https://cdn.storage.tiagofranca.com"

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD='ChangeMePassword123*'

## Bucket padrão e credenciais S3 criadas na inicialização
MINIO_DEFAULT_BUCKET=my-bucket
MINIO_DEFAULT_ACCESS_KEY=your_access_key_here
MINIO_DEFAULT_SECRET_KEY=your_secret_key_here

## ------------------------------------------------------------------------------
## Imagens Docker
## ------------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=minio/minio:latest
MINIO_IMAGE=chainguard/minio:latest
