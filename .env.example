## Portas de Object Storage (MinIO) através do Nginx
PORT_MINIO_API=7104 ## API S3 s3.exemplo.com.br 9000
PORT_MINIO_CONSOLE=7105 ## Console web minio.exemplo.com.br 9001

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password


## ------------------------------------------------------------------------------
## Imagens Docker
## ------------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=pgsty/silo:latest
