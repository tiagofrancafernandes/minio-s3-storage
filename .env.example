## Portas de Object Storage (MinIO) através do Nginx
PORT_MINIO_API=7104 ## API S3 s3.focusbook.com.br 9000
PORT_MINIO_CONSOLE=7105 ## Console web cdn.focusbook.com.br 9001

MINIO_SERVER_URL="https://s3.focusbook.com.br"
MINIO_BROWSER_REDIRECT_URL="https://cdn.focusbook.com.br"


MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD='ChangeMePassword123*'

## Bucket padrão e credenciais S3 criadas na inicialização
MINIO_DEFAULT_BUCKET=focusbook-prod
MINIO_DEFAULT_ACCESS_KEY=your_access_key_here
MINIO_DEFAULT_SECRET_KEY=your_secret_key_here

## Anotações / Referência para aplicação Focusbook
FOCUSBOOK_S3_BUCKET=focusbook-prod ### https://cdn.focusbook.com.br/browser/focusbook-prod ## https://s3.focusbook.com.br/
FOCUSBOOK_S3_ACCESS_KEY=your_access_key_here
FOCUSBOOK_S3_SECRET_KEY=your_secret_key_here

## ------------------------------------------------------------------------------
## Imagens Docker
## ------------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=minio/minio:latest
MINIO_IMAGE=chainguard/minio:latest
